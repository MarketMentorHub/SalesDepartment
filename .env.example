# ----------------------------------------------------------------------------
# MMH Sales Department — Umgebungsvariablen
# Kopiere diese Datei nach `.env` und fülle die Werte aus.
# ----------------------------------------------------------------------------

# --- Datenbank ---------------------------------------------------------------
# Im Docker-Compose-Setup zeigt der Host auf den Service-Namen "db".
DATABASE_URL="postgresql://sales:CHANGE_ME@db:5432/sales?schema=public"

# --- Auth.js / NextAuth ------------------------------------------------------
# Geheimnis für Session-Cookies. Generieren mit:  openssl rand -base64 32
AUTH_SECRET="CHANGE_ME_openssl_rand_base64_32"
# Öffentliche URL des Tools (für Auth-Redirects).
AUTH_URL="https://sales.mmh.capital"
# In Produktion hinter Reverse-Proxy: Auth.js den Host vertrauen lassen.
AUTH_TRUST_HOST="true"

# --- Claude (Anthropic) ------------------------------------------------------
# Treibt die Call-Analyse. Key aus der Anthropic Console.
ANTHROPIC_API_KEY="sk-ant-..."

# --- OpenAI Whisper (Transkriptions-Fallback) --------------------------------
# Nur nötig, falls Audio ohne fertiges Transkript reinkommt. Sonst leer lassen.
OPENAI_API_KEY="sk-..."

# --- n8n Ingest-API ----------------------------------------------------------
# Geheimer Schlüssel, den n8n im Header `X-API-Key` mitschickt.
# Generieren mit:  openssl rand -hex 24
INGEST_API_KEY="CHANGE_ME_openssl_rand_hex_24"

# --- Seed (Initial-Accounts) -------------------------------------------------
# Werden vom Seed-Skript zum Anlegen der drei Nutzer verwendet.
SEED_ADMIN_EMAIL="emilio@mmh.capital"
SEED_ADMIN_PASSWORD="CHANGE_ME"
SEED_STEPHEN_EMAIL="stephen@mmh.capital"
SEED_STEPHEN_PASSWORD="CHANGE_ME"
SEED_TORBEN_EMAIL="torben@mmh.capital"
SEED_TORBEN_PASSWORD="CHANGE_ME"

# Wohin Audio-Uploads geschrieben werden (im Container gemountetes Volume).
UPLOAD_DIR="/app/uploads"
